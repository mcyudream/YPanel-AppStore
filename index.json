{
  "name": "YPanel 官方源",
  "apps": [
    {
      "id": "uptime-kuma",
      "name": "Uptime Kuma",
      "category": "监控",
      "kind": "app",
      "description": "开箱即用的服务可用性监控（自带拨测与状态页）",
