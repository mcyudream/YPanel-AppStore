            }
          ]
        }
      ]
    },
    {
      "id": "rustfs",
      "name": "RustFS",
      "category": "中间件",
      "kind": "middleware",
      "description": "Rust 实现的高性能 S3 兼容对象存储（可复用中间件）",
      "author": "YuDream",
      "arch": [
        "amd64",
        "arm64"
      ],
      "logo": "apps/rustfs/logo.png",
      "readme": "apps/rustfs/README.md",
      "reverseProxy": "PANEL_APP_PORT",
      "versions": [
        {
          "id": "latest",
          "package": "apps/rustfs/latest",
          "env": [
            {
              "key": "RUSTFS_ACCESS_KEY",
              "label": "Access Key",
              "type": "text",
              "default": "ypadmin",
              "required": true
            },
            {
              "key": "RUSTFS_SECRET_KEY",
              "label": "Secret Key",
              "type": "password",
              "default": "yp_rustfs_2026",
              "required": true
            }
          ],
          "ports": [
            {
              "envKey": "PANEL_APP_PORT",
              "default": 9000
            }
          ]
        }
      ]
