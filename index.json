    {
      "id": "victoria-logs",
      "name": "VictoriaLogs",
      "category": "日志",
      "kind": "service",
      "description": "开源日志聚合与检索数据库（全字段索引、单机低资源），日志中心「集中存储」模式后端",
      "author": "YuDream",
      "arch": [
        "amd64",
        "arm64"
      ],
      "logo": "apps/victoria-logs/logo.svg",
      "readme": "apps/victoria-logs/README.md",
      "reverseProxy": "PANEL_APP_PORT",
      "versions": [
        {
          "id": "1.53.0",
          "package": "apps/victoria-logs/1.53.0",
          "releaseNotes": "首版",
          "env": [
            {
              "key": "RETENTION_PERIOD",
              "label": "日志保留期（如 7d/30d/90d/180d/1y）",
              "type": "text",
              "default": "30d",
              "required": true
            }
          ],
          "ports": [
            {
              "envKey": "PANEL_APP_PORT",
              "default": 9428
            }
          ]
        }
      ]
