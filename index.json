      "arch": [
        "amd64",
        "arm64"
      ],
      "logo": "apps/uptime-kuma/logo.svg",
      "readme": "apps/uptime-kuma/README.md",
      "reverseProxy": "PANEL_APP_PORT",
      "versions": [
        {
          "id": "1.23.16",
          "package": "apps/uptime-kuma/1.23.16",
          "releaseNotes": "首版",
          "ports": [
            {
              "envKey": "PANEL_APP_PORT",
              "default": 3001
            }
          ]
        }
      ]
    },
    {
      "id": "memcached",
