    {
      "id": "vector",
      "name": "Vector 日志采集器",
      "category": "日志",
      "kind": "service",
      "description": "采集本机全部容器日志推送至 VictoriaLogs 集中存储（多节点各装一份即可跨节点检索）",
      "author": "YuDream",
      "arch": [
        "amd64",
        "arm64"
      ],
      "logo": "apps/vector/logo.svg",
      "readme": "apps/vector/README.md",
      "versions": [
        {
          "id": "0.49.0",
          "package": "apps/vector/0.49.0",
          "releaseNotes": "首版",
          "env": [
            {
              "key": "VL_ENDPOINT",
              "label": "VictoriaLogs 地址（同网络容器名或内网IP:端口）",
              "type": "text",
              "default": "http://victoria-logs:9428",
              "required": true
            }
          ]
        }
      ]
