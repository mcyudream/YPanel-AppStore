    {
      "id": "harbor",
      "name": "Harbor",
      "category": "DevOps",
      "kind": "app",
      "description": "CNCF 毕业的云原生镜像仓库：漏洞扫描（Trivy）、镜像签名、多租户 RBAC、跨仓复制",
      "author": "YuDream",
      "arch": [
        "amd64",
        "arm64"
      ],
      "logo": "apps/harbor/logo.svg",
      "readme": "apps/harbor/README.md",
      "reverseProxy": "PANEL_APP_PORT",
      "website": "https://goharbor.io",
      "sourceUrl": "https://github.com/goharbor/harbor",
      "document": "https://goharbor.io/docs/",
      "versions": [
        {
          "id": "2.15.4",
          "package": "apps/harbor/2.15.4/package",
          "releaseNotes": "首版（对齐官方 v2.15.4，prepare 初始化 + 全组件）",
          "env": [
            {
              "key": "HARBOR_HOSTNAME",
              "label": "访问主机名（docker login 用 IP 或域名，勿填 localhost）",
              "type": "text",
              "default": "harbor.local",
              "required": true,
              "description": "生成的访问地址为 http://<主机名>:<端口>；配合域名反代时填该域名"
            },
            {
              "key": "HARBOR_ADMIN_PASSWORD",
              "label": "admin 初始密码",
              "type": "password",
              "random": true,
              "required": true,
              "description": "仅首次安装生效，之后在 Harbor UI 修改；避免 $ 引号反引号等特殊字符"
            },
            {
              "key": "HARBOR_DB_PASSWORD",
              "label": "内置数据库密码",
              "type": "password",
              "random": true,
              "required": true
            },
            {
              "key": "PANEL_APP_PORT",
              "label": "HTTP 端口",
              "type": "number",
              "default": 30080,
              "rule": "paramPort",
              "required": true
            }
          ],
          "ports": [
            {
              "envKey": "PANEL_APP_PORT",
              "default": 30080
            }
          ]
        }
      ]
    },
    {
      "id": "mihomo",
      "name": "Mihomo (Clash Meta)",
      "category": "网络",
      "kind": "app",
      "description": "Mihomo 代理内核 + metacubexd 可视化面板：HTTP/SOCKS5 混合代理、规则/订阅、连接与节点可视化管理",
      "author": "YuDream",
      "arch": [
        "amd64",
        "arm64"
      ],
      "logo": "apps/mihomo/logo.png",
      "readme": "apps/mihomo/README.md",
      "versions": [
        {
          "id": "1.19.32",
          "package": "apps/mihomo/1.19.32/package",
          "releaseNotes": "首版（Mihomo v1.19.32 + metacubexd v1.273.1，默认全直连最小配置）",
          "env": [
            {
              "key": "PANEL_APP_PORT",
              "label": "代理端口（HTTP+SOCKS5 混合）",
              "type": "number",
              "default": 37890,
              "rule": "paramPort",
              "required": true
            },
            {
              "key": "PANEL_API_PORT",
              "label": "外部控制器端口",
              "type": "number",
              "default": 37891,
              "rule": "paramPort",
              "required": true,
              "description": "metacubexd 面板连接此端口（http://<主机IP>:<端口>，密钥默认空）"
            },
            {
              "key": "PANEL_UI_PORT",
              "label": "面板访问端口",
              "type": "number",
              "default": 39097,
              "rule": "paramPort",
              "required": true
            }
          ],
          "ports": [
            {
              "envKey": "PANEL_APP_PORT",
              "default": 37890
            },
            {
              "envKey": "PANEL_API_PORT",
              "default": 37891
            },
            {
              "envKey": "PANEL_UI_PORT",
              "default": 39097
            }
          ]
        }
      ],
      "adminUI": {
        "port": "PANEL_API_PORT",
        "path": "/ui/",
        "name": "Mihomo 管理台"
      }
    },
    {
      "id": "element-skin",
      "name": "Element Skin",
      "category": "游戏",
      "kind": "app",
      "description": "现代化 Minecraft 皮肤站：Go+Vue3，Yggdrasil 外置登录、皮肤披风 3D 预览、OIDC/Microsoft 角色绑定",
      "author": "water2004",
      "arch": [
        "amd64",
        "arm64"
      ],
      "logo": "apps/element-skin/logo.svg",
      "readme": "apps/element-skin/README.md",
      "website": "https://github.com/water2004/element-skin",
      "sourceUrl": "https://github.com/water2004/element-skin",
      "versions": [
        {
          "id": "4.0.1",
          "package": "apps/element-skin/4.0.1/package",
          "releaseNotes": "首版（对齐官方 v4.0.1 compose：backend + webhook-worker + PostgreSQL 18 + Redis 8）",
          "env": [
            {
              "key": "SERVER_SITE_URL",
              "label": "站点访问地址",
              "type": "text",
              "default": "http://127.0.0.1:38080",
              "required": true,
              "description": "浏览器实际访问地址（含端口），CORS/OIDC/启动器依赖它；换域名或端口后改此参数并重启"
            },
            {
              "key": "JWT_SECRET",
              "label": "JWT 密钥",
              "type": "password",
              "random": true,
              "required": true,
              "randomLen": 48
            },
            {
              "key": "IDENTITY_ENCRYPTION_KEY",
              "label": "身份加密密钥",
              "type": "password",
              "random": true,
              "required": true,
              "description": "加密 OIDC client secret 与外部 refresh token；配置过身份提供方后不可更改",
              "randomLen": 48
            },
            {
              "key": "DATABASE_PASSWORD",
              "label": "数据库密码",
              "type": "password",
              "random": true,
              "required": true
            },
            {
              "key": "REDIS_PASSWORD",
              "label": "Redis 密码",
              "type": "password",
              "random": true,
              "required": true
            },
            {
              "key": "PANEL_APP_PORT",
              "label": "站点端口",
              "type": "number",
              "default": 38080,
              "rule": "paramPort",
              "required": true
            }
          ],
          "ports": [
            {
              "envKey": "PANEL_APP_PORT",
              "default": 38080
            }
          ]
        }
      ]
    },
