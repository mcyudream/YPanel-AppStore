{
  "php": {
    "versions": [
      "8.0",
      "8.1"
    ],
    "default": "8.1",
    "extensions": {
      "required": [
        "gd",
        "zip",
        "pdo_mysql"
      ],
      "optional": [
        "imagick",
        "opcache",
        "redis"
      ]
    },
    "ini": {}
  },
  "web": {
    "rewrite": "laravel",
    "root": "public"
  },
  "database": {
    "engine": "mysql",
    "create": true
  },
  "install": [],
  "sourceUrl": "assets/blessing-skin-server-6.0.2.zip",
  "upgrade": {
    "commands": [
      "php artisan migrate --force"
    ],
    "backup": true
  }
}